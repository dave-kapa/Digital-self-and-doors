{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ClaimEntrySchemaV1",
  "type": "object",
  "required": [
    "claim_id",
    "statement",
    "epistemic_status",
    "evidence_status",
    "review_status",
    "confidence",
    "allowed_uses",
    "last_verified"
  ],
  "properties": {
    "claim_id": {
      "type": "string",
      "pattern": "^CLAIM-[A-Z0-9-]+$"
    },
    "statement": {
      "type": "string",
      "minLength": 10
    },
    "epistemic_status": {
      "type": "string",
      "enum": [
        "established",
        "supported",
        "provisional",
        "speculative",
        "mixed"
      ]
    },
    "evidence_status": {
      "type": "string",
      "enum": [
        "complete",
        "partial",
        "unresolved",
        "contradicted"
      ]
    },
    "review_status": {
      "type": "string",
      "enum": [
        "draft",
        "pending_review",
        "reviewed",
        "approved",
        "suspended"
      ]
    },
    "confidence": {
      "type": "string",
      "enum": [
        "very_high",
        "high",
        "medium",
        "low"
      ]
    },
    "scope": {
      "type": "string"
    },
    "supported_by": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source_id",
          "relation"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "pattern": "^SRC-[A-Z0-9-]+$"
          },
          "relation": {
            "type": "string",
            "enum": [
              "direct_support",
              "partial_support",
              "contextual",
              "qualifies",
              "contradicts",
              "unspecified_legacy"
            ]
          }
        }
      }
    },
    "evidenced_by": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "evidence_id",
          "relation"
        ],
        "properties": {
          "evidence_id": {
            "type": "string",
            "pattern": "^EVD-[A-Z0-9-]+$"
          },
          "relation": {
            "type": "string",
            "enum": [
              "preliminary_signal",
              "longitudinal_field",
              "pilot_metric"
            ]
          }
        }
      }
    },
    "grounded_in": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "allowed_uses": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "internal_research",
          "commercial",
          "training_content",
          "external_publication"
        ]
      }
    },
    "topics": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "limitations": {
      "type": "string"
    },
    "last_verified": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "next_review": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "derived_from_candidates": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^CAND-[A-Z0-9-]+-[0-9]{3}$"
      }
    }
  },
  "additionalProperties": false
}
